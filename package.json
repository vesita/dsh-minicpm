{
  "name": "dsh-minicpm",
  "version": "0.1.1",
  "description": "DSH 插件：MiniCPM5-2B 本地推理提供商 —— 原生模型接入，由插件托管 llama.cpp 引擎的下载、启动与卸载",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-minicpm": "./lib/bin.js"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && chmod +x lib/bin.js",
    "prepack": "npm run build",
    "test": "npm run build && node test/test.js",
    "test:types": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.1",
    "@types/node": "^22.20.1",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.1"
  },
  "keywords": [
    "dsh",
    "minicpm",
    "llama.cpp",
    "gguf",
    "local",
    "llm",
    "cordis"
  ],
  "license": "MIT"
}
